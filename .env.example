# EarnSecure — example environment (.env.example)
# Copy this file to `.env` (root) for Expo/frontend use and fill values.
# For backend env, copy `backend/.env.example` to `backend/.env.local` and fill values there.

# -------------------------
# Frontend (Expo / React Native)
# -------------------------
# Base URL for API requests from the mobile app. Include protocol and port if needed.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Environment name used in the app (development | staging | production)
EXPO_PUBLIC_ENV=development

# Optional: public API keys used client-side (only include keys safe for client use)
EXPO_PUBLIC_OPENWEATHERMAP_API_KEY=
EXPO_PUBLIC_MAPS_API_KEY=

# Optional: Sentry DSN (monitoring)
SENTRY_DSN=

# -------------------------
# Notes
# -------------------------
# - Backend env sample exists at `backend/.env.example` (copy to `backend/.env.local`).
# - Quick setup:
#     cp .env.example .env
#     cp backend/.env.example backend/.env.local
# - For CI/CD, set secrets using platform's secret manager rather than committing them.
