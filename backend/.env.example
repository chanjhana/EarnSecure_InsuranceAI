# ─────────────────────────────────────────────────────────
# EarnSecure Backend — Environment Configuration
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────

# ── OpenWeatherMap (free tier – weather + rain + heat + fog triggers) ──
# Sign up at https://openweathermap.org/api and get your free API key.
OPENWEATHERMAP_API_KEY=your_key_here

# ── TomTom Traffic API (traffic + roadblock bbox polling) ──
TOMTOM_API_KEY=your_tomtom_key_here

# ── JWT ──
JWT_SECRET=earnsecure-dev-secret-change-me-32b
JWT_ACCESS_TTL_MINUTES=1440

# ── Admin Login ──
# SHA-256 hash of the admin password.
# Generate with:  python -c "import hashlib; print(hashlib.sha256(b'YOUR_PASSWORD').hexdigest())"
ADMIN_SECRET_HASH=

# ── PostgreSQL (optional – leave blank to use in-memory store) ──
DATABASE_URL=

# ── CPCB Sameer AQI API (Free tier – data.gov.in) ──
CPCB_API_KEY=your_data_gov_in_api_key_here

# ── Twilio Messaging API (Optional) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# ── Twilio Voice / IVR (Optional) ──
TWILIO_VOICE_FROM_PHONE=
TWILIO_WEBHOOK_BASE_URL=https://example.ngrok-free.app

# ── Razorpay (use test keys in development) ──
RAZORPAY_KEY_ID=rzp_test_example_key
RAZORPAY_KEY_SECRET=razorpay_test_secret_placeholder
RAZORPAY_COMPANY_NAME=EarnSecure Insurance
RAZORPAY_CURRENCY=INR
RAZORPAY_CHECKOUT_BASE_URL=https://checkout.razorpay.com/v1/checkout.js

# ── UPI fallback (scan and pay) ──
UPI_PAYEE_VPA=earnsecure.demo@okaxis
UPI_PAYEE_NAME=EarnSecure Insurance

# ── Traffic trigger tuning ──
TRAFFIC_JAM_FACTOR_THRESHOLD=1.5
TRAFFIC_ROADBLOCK_THRESHOLD=1
TRAFFIC_TREATMENT_WINDOW_HOURS=6
TRAFFIC_MOTION_DROP_THRESHOLD=0.6
TRAFFIC_MOTION_WINDOW_MINUTES=25
